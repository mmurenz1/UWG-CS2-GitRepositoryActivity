<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="740.0" prefWidth="557.0" spacing="20.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.westga.cs1302.javafx_sample_starter.views.MainWindow">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <AnchorPane prefHeight="841.0" prefWidth="517.0">
         <children>
            <Button layoutX="246.0" layoutY="178.0" mnemonicParsing="false" onAction="#addButton" text="+" />
            <TextField fx:id="taskNameField" layoutX="54.0" layoutY="130.0" prefHeight="25.0" prefWidth="388.0" />
            <Label layoutX="223.0" layoutY="88.0" text="Task Name" />
            <ListView fx:id="taskDescriptionArea" layoutX="54.0" layoutY="256.0" onEditStart="#popUpFavorite" onMouseClicked="#selectMovie" prefHeight="200.0" prefWidth="388.0" />
            <Label layoutX="220.0" layoutY="470.0" text="Task Priority" />
            <ComboBox fx:id="taskPriorityComboBox" layoutX="173.0" layoutY="516.0" prefWidth="150.0" />
            <Label layoutX="221.0" layoutY="225.0" text="Task Description" />
            <Button fx:id="taskListView" layoutX="222.0" layoutY="575.0" mnemonicParsing="false" onAction="#addButton" text="Add Task" />
         </children>
      </AnchorPane>
   </children>
</VBox>
